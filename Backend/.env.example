DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=kkp_investasi
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD_HERE
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0

CACHE_URL=

THROTTLE_ANON=
THROTTLE_USER=
THROTTLE_PETA=
THROTTLE_ASISTEN=
THROTTLE_ASISTEN_PUBLIK=
# Jumlah proxy di depan Django (nginx = 1); dipakai untuk membaca IP asli pengunjung pada kuota per IP
NUM_PROXIES=1

# Asisten (model bahasa). Kosongkan ASISTEN_LLM_URL bila server model belum ada: ikon asisten tetap berjalan dalam mode panduan.
# ASISTEN_LLM_URL   : alamat /v1 server model (vLLM, dengan /chat/completions), jaringan internal saja, mis. http://10.0.0.20:8000/v1
# ASISTEN_LLM_MODEL : nama model persis seperti di GET <ASISTEN_LLM_URL>/models
# ASISTEN_LLM_KUNCI : nilai --api-key vLLM (dikirim sebagai Bearer)
# ASISTEN_LLM_TIMEOUT : batas detik satu pertanyaan (semua putaran alat); nginx dan kkp-asisten.service memberi 180 detik
# ASISTEN_LLM_EKSTRA : JSON tambahan untuk /chat/completions; vLLM + Qwen: {"chat_template_kwargs":{"enable_thinking":false}}
#                      LM Studio: {"reasoning_effort":"none"}
# ASISTEN_BATAS_HASIL : batas karakter hasil satu alat yang dikirim ke model; 12000 untuk konteks >= 32k token, 6000 untuk 8k
# THROTTLE_ASISTEN   : kuota per pengguna yang sudah masuk, bawaan 120/hour
# THROTTLE_ASISTEN_PUBLIK : kuota pengunjung yang belum masuk per alamat IP, bawaan 30/hour
# Produksi: rute /api/v1/inti/asisten/obrolan/ dilayani proses terpisah, lihat deploy/kkp-asisten.service dan deploy/nginx-asisten.conf
ASISTEN_LLM_URL=
ASISTEN_LLM_MODEL=
ASISTEN_LLM_KUNCI=
ASISTEN_LLM_TIMEOUT=120
ASISTEN_LLM_EKSTRA=
ASISTEN_BATAS_HASIL=12000

BIG_API_KEY=
BIG_API_URL=https://api.big.go.id

BPS_API_KEY=
BPS_API_URL=https://webapi.bps.go.id/v1

BMKG_API_KEY=
BMKG_API_URL=https://data.bmkg.go.id/DataMKG

KKP_API_KEY=
KKP_API_URL=

DJPRL_API_KEY=
DJPRL_API_URL=

BNPB_GIS_URL=https://gis.bnpb.go.id/server/rest/services/inarisk

GFW_TOKEN=

FRANKFURTER_URL=https://api.frankfurter.app/latest

FIELD_ENCRYPTION_KEY=

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

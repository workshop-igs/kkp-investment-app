# Salin berkas ini menjadi .env lalu isi nilainya. Penjelasan lengkap ada di Panduan Setup Produksi.
# Baris yang sengaja dikosongkan berisi rahasia (kata sandi, token) dan wajib diisi sendiri; jangan pernah disimpan ke repositori.

# Wajib diganti: teks acak panjang dan rahasia, mis. hasil `python -c "import secrets; print(secrets.token_urlsafe(50))"`
DJANGO_SECRET_KEY=ganti-dengan-teks-acak-panjang
# Produksi: False
DJANGO_DEBUG=True
# Produksi: nama domain aplikasi, mis. investasi.kkp.go.id
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=kkp_investasi
DB_USER=postgres
DB_PASSWORD=isi-kata-sandi-basis-data
DB_HOST=localhost
DB_PORT=5432

# Antrean tugas latar (Celery) dan cache bersama; produksi wajib memakai Redis
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1

# Kuota permintaan; nilai berikut sama dengan bawaan aplikasi
THROTTLE_ANON=20000/hour
THROTTLE_USER=6000/hour
THROTTLE_PETA=20000/hour
THROTTLE_ASISTEN=120/hour
THROTTLE_ASISTEN_PUBLIK=30/hour
# Jumlah proxy di depan Django (nginx = 1); dipakai untuk membaca IP asli pengunjung pada kuota per IP
NUM_PROXIES=1
# Login ditahan 15 menit setelah sekian salah sandi: per akun, dan per alamat internet (satu kantor biasanya berbagi satu alamat)
LOGIN_GAGAL_MAKS_AKUN=10
LOGIN_GAGAL_MAKS_ALAMAT=200

# Asisten (model bahasa). Kosongkan ASISTEN_LLM_URL bila server model belum ada: ikon asisten tetap berjalan dalam mode panduan.
# ASISTEN_LLM_URL   : alamat /v1 server model (vLLM, dengan /chat/completions), jaringan internal saja, mis. http://10.0.0.20:8000/v1
# ASISTEN_LLM_MODEL : nama model persis seperti di GET <ASISTEN_LLM_URL>/models
# ASISTEN_LLM_KUNCI : nilai --api-key vLLM (dikirim sebagai Bearer); kosongkan bila server model tidak memakai kunci
# ASISTEN_LLM_TIMEOUT : batas detik satu pertanyaan (semua putaran alat); nginx dan kkp-asisten.service memberi 180 detik
# ASISTEN_LLM_EKSTRA : JSON tambahan untuk /chat/completions; vLLM + Qwen: {"chat_template_kwargs":{"enable_thinking":false}}
#                      LM Studio: {"reasoning_effort":"none"}
# ASISTEN_BATAS_HASIL : batas karakter hasil satu alat yang dikirim ke model; 12000 untuk konteks >= 32k token, 6000 untuk 8k
# Produksi: rute /api/v1/inti/asisten/obrolan/ dilayani proses terpisah, lihat deploy/kkp-asisten.service dan deploy/nginx-asisten.conf
ASISTEN_LLM_URL=
ASISTEN_LLM_MODEL=
ASISTEN_LLM_KUNCI=
ASISTEN_LLM_TIMEOUT=120
ASISTEN_LLM_EKSTRA={}
ASISTEN_BATAS_HASIL=12000

# Kunci WebAPI BPS (daftar gratis di webapi.bps.go.id); dipakai untuk statistik ketenagakerjaan dan produksi perikanan
BPS_API_KEY=

BNPB_GIS_URL=https://gis.bnpb.go.id/server/rest/services/inarisk

# Token API Global Fishing Watch (daftar gratis di globalfishingwatch.org/our-apis); dipakai untuk layer aktivitas penangkapan ikan
GFW_TOKEN=

FRANKFURTER_URL=https://api.frankfurter.app/latest

# Layanan peta WMS/WFS/WCS (MapServer di alamat /ows). Isi dengan akun basis data KHUSUS yang hanya boleh membaca
# tabel data rujukan; daftar hak aksesnya dicetak oleh: python manage.py buat_mapfile --sql-hak <nama_akun>.
# Kosongkan bila layanan peta belum dipasang; mapfile tidak dibuat.
PETA_DB_USER=
PETA_DB_PASSWORD=
PETA_URL=https://investasi.kkp.go.id/ows

[Unit]
Description=KKP Investment App - gunicorn
After=network.target postgresql.service redis-server.service

[Service]
User=deploy
WorkingDirectory=/home/deploy/kkp/Backend
ExecStart=/home/deploy/kkp/Backend/venv_django/bin/gunicorn kkp_investasi.wsgi:application --bind 127.0.0.1:8001 --worker-class gthread --workers 5 --threads 4 --timeout 120 --max-requests 1000 --max-requests-jitter 100 --access-logfile - --error-logfile -
Restart=always

[Install]
WantedBy=multi-user.target
